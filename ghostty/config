# Ghostty config (macOS host). The main window runs dev-attach (ssh + tmux on
# the dev server, reconnecting after sleep/network drops); the quick terminal
# (ctrl+`) drops local tmux over the screen via bashrc_osx's auto-attach.

# Font
font-family = JetBrainsMono Nerd Font
font-size = 14.5
adjust-cell-height = 4

# Window
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
macos-titlebar-style = transparent
# Windows open as normal windows; cmd+enter toggles fullscreen. Non-native
# fullscreen hides the menu bar without its own Space, so moving the window
# to another monitor does not leave a black Space behind.
macos-non-native-fullscreen = true
mouse-hide-while-typing = true

# One Dark refined. Spelled out instead of a bundled theme name so it can't
# drift between Ghostty releases.
background = #282c34
foreground = #abb2bf
cursor-color = #abb2bf
cursor-text = #282c34
palette = 0=#282c34
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#abb2bf
palette = 8=#5c6370
palette = 9=#e06c75
palette = 10=#98c379
palette = 11=#e5c07b
palette = 12=#61afef
palette = 13=#c678dd
palette = 14=#56b6c2
palette = 15=#c8ccd4

# tmux owns scrollback
scrollback-limit = 0

# Keep the block cursor (shell integration would switch it to a bar at the prompt)
shell-integration-features = no-cursor

# Main window: dev server tmux. initial-command only applies to the first
# window at launch; new windows and the quick terminal get a normal shell.
initial-command = /bin/bash -c 'exec "$HOME/bin/dev-attach"'

# Quick terminal: local Mac tmux
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 80%
