# ─── One-time host setup (do this when bootstrapping a new laptop) ────────
# remotesend / clipboard back-channel: add a RemoteForward block to
# ~/.ssh/config for each remote host you want to reach back to this Mac.
# Use ForwardAgent so the remote can re-authenticate back to this Mac
# without needing a private key stored on the remote:
#
#   Host dev mybox other-trusted-host
#     RemoteForward 6788 localhost:22
#     ForwardAgent yes
#
# Then on this Mac:
#   1. Add this Mac's own ~/.ssh/id_*.pub to ~/.ssh/authorized_keys
#      (so the remote, via the forwarded agent, can ssh back in).
#   2. System Settings → General → Sharing → Remote Login: ON
#      (otherwise port 22 isn't listening to receive the tunneled scp).
#
# Once that's in place, `remotesend foo.tar.gz` on the remote scp's the
# file to ~/Downloads here. Don't apply this to untrusted hosts — anyone
# with code execution there gets an SSH-back channel to this Mac (and
# access to the forwarded agent) for the duration of the session.
#
# link_up deliberately doesn't auto-edit ~/.ssh/config (too personal to
# clobber), so this is a manual step on each new machine.
#
# Ghostty + dev-attach: keep the dev connection's liveness checks short so
# dev-attach notices a dead link (lid close, wifi change) and reconnects:
#
#   Host mwesterhof-dev-server
#     ServerAliveInterval 15
#     ServerAliveCountMax 3
#
# The dev server has no xterm-ghostty terminfo entry; install it once:
#
#   infocmp -x xterm-ghostty | ssh mwesterhof-dev-server -- tic -x -
#
# Optional, on the server's /etc/ssh/sshd_config, so a stale connection
# frees RemoteForward 6788 quickly and remotesend works after a reconnect:
#
#   ClientAliveInterval 15
#   ClientAliveCountMax 3
# ──────────────────────────────────────────────────────────────────────────

if [[ ! $- =~ "i" ]]; then
    # Not an interactive shell.
    return
fi

PS1='\[\e[0;32m\]\u\[\e[m\] \[\e[1;34m\]\w\[\e[m\] \[\e[1;32m\]\$\[\e[m\] '
export CLICOLOR=1
export LSCOLORS=ExFxBxDxCxegedabagacad

alias ll='ls -l'

eval "$(/opt/homebrew/bin/brew shellenv)"

# Ghostty's quick terminal (and any extra window) lands in local tmux. Not
# exec'd, so detaching drops to a plain shell. The main window runs
# dev-attach directly rather than an interactive shell, so this skips it.
if [ "$TERM_PROGRAM" = ghostty ] && [ -z "$TMUX" ]; then
    tmux new -A -s local
fi

[[ -r "$(brew --prefix)/etc/profile.d/bash_completion.sh" ]] && . $(brew --prefix)/etc/profile.d/bash_completion.sh
