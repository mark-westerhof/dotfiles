#!/usr/bin/env bash
# Keep a tmux session on the dev server attached; reconnect after sleep or network drops.
host=${1:-mwesterhof-dev-server}   # ssh alias; pass another as $1 if it changes
trap 'exit 130' INT

# tmux on the server refuses to start under TERM=xterm-ghostty unless the
# server has Ghostty's terminfo entry; push it over once if it's missing.
if [ "$TERM" = xterm-ghostty ] && infocmp -x xterm-ghostty >/dev/null 2>&1; then
  infocmp -x xterm-ghostty | ssh -o ConnectTimeout=5 "$host" \
    'infocmp xterm-ghostty >/dev/null 2>&1 || tic -x - 2>/dev/null' 2>/dev/null
fi

while true; do
  ssh -t "$host" 'tmux attach 2>/dev/null || tmux new -s main' && exit 0
  printf '\n\e[33mconnection to %s lost, reconnecting in 2s (ctrl-c to stop)\e[m\n' "$host"
  sleep 2
done
